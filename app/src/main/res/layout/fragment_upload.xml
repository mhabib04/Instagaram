<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".activities.fragments.UploadFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top app bar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/surface"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/title_new_post"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <View style="@style/Divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Photo picker: shown until a photo is chosen -->
                <FrameLayout
                    android:id="@+id/dropZone"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="@drawable/bg_dropzone"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_add_photo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="@string/pick_from_gallery"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtAddImageSize"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/photo_formats_hint" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Preview sized exactly like imgPost in list_post_home.xml, so the user sees
                     the post as it will appear in the feed (20dp side inset = card margin + padding). -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgSelectImageUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:adjustViewBounds="true"
                    android:background="@color/surface_variant"
                    android:contentDescription="@string/title_post"
                    android:maxHeight="560dp"
                    android:minHeight="220dp"
                    android:scaleType="center"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/RoundedMedia" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectImageUpload"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:letterSpacing="0"
                    android:text="@string/pick_photo"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_add_photo"
                    app:iconGravity="textStart"
                    app:iconSize="22dp"
                    app:iconTint="@color/text_primary"
                    app:strokeColor="@color/outline" />

                <!-- Caption -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="@string/caption_label"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etUploadCaption"
                    style="@style/Input"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="top"
                    android:hint="@string/caption_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:minLines="4"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:animateLayoutChanges="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpload"
                        style="@style/Button.Gradient"
                        android:layout_width="match_parent"
                        android:text="@string/share_now" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>
