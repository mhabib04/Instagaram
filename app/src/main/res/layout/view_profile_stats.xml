<?xml version="1.0" encoding="utf-8"?>
<!-- Posts | Followers | Following | Likes, shared by the own profile and visited profiles.
     colFollowers / colFollowing are only made clickable on the own profile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/totalPosts"
            style="@style/ProfileStat.Number"
            tools:text="12" />

        <TextView
            style="@style/ProfileStat.Label"
            android:text="@string/label_posts" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/colFollowers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/totalFollowers"
            style="@style/ProfileStat.Number"
            tools:text="120" />

        <TextView
            style="@style/ProfileStat.Label"
            android:text="@string/label_followers" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/colFollowing"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/totalFollowing"
            style="@style/ProfileStat.Number"
            tools:text="87" />

        <TextView
            style="@style/ProfileStat.Label"
            android:text="@string/label_following" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/totalLikes"
            style="@style/ProfileStat.Number"
            tools:text="348" />

        <TextView
            style="@style/ProfileStat.Label"
            android:text="@string/label_likes" />

    </LinearLayout>

</LinearLayout>
