<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:importantForAutofill="noExcludeDescendants"
    tools:context=".activities.RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/txtInstagaram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/grandhotel"
            android:text="@string/instagaram"
            android:textColor="@color/text_primary"
            android:textSize="46sp" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/register_tagline"
            android:textSize="14sp" />

        <!-- Avatar picker -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/imgProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/background_image"
                android:contentDescription="@string/cd_pick_profile_photo"
                android:scaleType="centerCrop"
                app:riv_oval="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgAddImage"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_add_photo" />

                <TextView
                    android:id="@+id/txtAddImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="@string/add_photo"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtAddImageSize"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/max_photo_size"
                    android:textSize="10sp" />

            </LinearLayout>


        </FrameLayout>


        <EditText
            android:id="@+id/etUsername"
            style="@style/Input"
            android:layout_marginTop="28dp"
            android:hint="@string/hint_username"
            android:imeOptions="actionNext"
            android:inputType="text|textNoSuggestions"
            android:maxLength="25" />

        <!-- Live availability, updated while typing the username -->
        <TextView
            android:id="@+id/txtUsernameStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/montserrat_medium"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="@string/error_username_too_short"
            tools:textColor="@color/like_red"
            tools:visibility="visible" />

        <EditText
            android:id="@+id/etName"
            style="@style/Input"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_full_name"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="25" />

        <EditText
            android:id="@+id/etPassword"
            style="@style/Input"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_password"
            android:imeOptions="actionNext"
            android:inputType="textPassword" />

        <!-- Shown while the new password is shorter than the minimum -->
        <TextView
            android:id="@+id/txtPasswordRule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/montserrat_medium"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="@string/error_password_too_short"
            tools:textColor="@color/like_red"
            tools:visibility="visible" />

        <EditText
            android:id="@+id/etConfirmPassword"
            style="@style/Input"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_confirm_password"
            android:imeOptions="actionDone"
            android:inputType="textPassword" />

        <!-- Live match feedback, updated while typing the confirmation -->
        <TextView
            android:id="@+id/txtPasswordMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:drawablePadding="6dp"
            android:fontFamily="@font/montserrat_medium"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="@string/password_mismatch"
            tools:textColor="@color/like_red"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:animateLayoutChanges="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                style="@style/Button.Gradient"
                android:layout_width="match_parent"
                android:text="@string/sign_up" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <View style="@style/Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_have_account"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/montserrat_bold"
                android:padding="4dp"
                android:text="@string/action_login"
                android:textColor="@color/primary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
