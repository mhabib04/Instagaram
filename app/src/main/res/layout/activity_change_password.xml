<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".activities.ChangePasswordActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/title_change_password" />

    </LinearLayout>

    <View style="@style/Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Step 1: confirm the current password -->
            <LinearLayout
                android:id="@+id/stepCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/current_password_prompt" />

                <EditText
                    android:id="@+id/etCurrentPassword"
                    style="@style/Input"
                    android:hint="@string/hint_current_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNext"
                        style="@style/Button.Gradient"
                        android:layout_width="match_parent"
                        android:enabled="false"
                        android:text="@string/action_next" />

                    <ProgressBar
                        android:id="@+id/progressNext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <!-- Step 2: choose the new password (shown after step 1 succeeds) -->
            <LinearLayout
                android:id="@+id/stepNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/new_password_prompt" />

                <EditText
                    android:id="@+id/etNewPassword"
                    style="@style/Input"
                    android:hint="@string/hint_new_password"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />

                <!-- Shown while the new password is shorter than the minimum -->
                <TextView
                    android:id="@+id/txtPasswordRule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="@string/error_password_too_short"
                    tools:textColor="@color/like_red"
                    tools:visibility="visible" />

                <EditText
                    android:id="@+id/etConfirmNewPassword"
                    style="@style/Input"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_confirm_new_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/txtPasswordMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="@string/password_mismatch"
                    tools:visibility="visible" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSavePassword"
                        style="@style/Button.Gradient"
                        android:layout_width="match_parent"
                        android:enabled="false"
                        android:text="@string/action_save" />

                    <ProgressBar
                        android:id="@+id/progressSave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

        </FrameLayout>

    </ScrollView>

</LinearLayout>
