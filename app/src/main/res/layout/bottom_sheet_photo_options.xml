<?xml version="1.0" encoding="utf-8"?>
<!-- Shown when the user taps their own profile photo: change it or remove it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:text="@string/title_profile_photo"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <View style="@style/Divider" />

    <TextView
        android:id="@+id/optChangePhoto"
        style="@style/SheetOption"
        android:text="@string/action_change_photo"
        app:drawableStartCompat="@drawable/ic_add_photo_small" />

    <TextView
        android:id="@+id/optDeletePhoto"
        style="@style/SheetOption"
        android:text="@string/action_delete_photo"
        android:textColor="@color/like_red"
        app:drawableStartCompat="@drawable/ic_delete_red" />

</LinearLayout>
