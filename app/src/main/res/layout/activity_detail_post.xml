<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".activities.DetailPostActivity">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarPost"
            style="@style/AppToolbar">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_post" />

        </androidx.appcompat.widget.Toolbar>

        <View
            android:id="@+id/rlToolbar"
            style="@style/Divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Header -->
                <LinearLayout
                    android:id="@+id/headerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <FrameLayout
                        style="@style/StoryRing"
                        android:layout_width="44dp"
                        android:layout_height="44dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/imgProfilePost"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/avatar_default"
                            app:civ_border_color="@color/surface"
                            app:civ_border_width="2dp"
                            app:civ_circle_background_color="@color/surface_variant" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtUsernamePost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat_bold"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            tools:text="\@username" />

                        <TextView
                            android:id="@+id/txtDatePost"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            tools:text="10 Oct 2026" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnOption"
                        style="@style/IconButton"
                        android:visibility="gone"
                        android:contentDescription="@string/cd_options"
                        android:src="@drawable/ic_more" />

                </LinearLayout>

                <!-- Photo -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgPost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:adjustViewBounds="true"
                    android:background="@color/surface_variant"
                    android:maxHeight="640dp"
                    android:minHeight="240dp"
                    android:scaleType="center"
                    app:shapeAppearanceOverlay="@style/RoundedMedia" />

                <!-- Actions -->
                <LinearLayout
                    android:id="@+id/button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/btnDisLike"
                            style="@style/IconButton"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:contentDescription="@string/cd_unlike"
                            android:src="@drawable/ic_heart_filled"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/btnLike"
                            style="@style/IconButton"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:contentDescription="@string/cd_like"
                            android:src="@drawable/ic_heart" />

                    </FrameLayout>

                    <ImageView
                        android:id="@+id/btnShare"
                        style="@style/IconButton"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:contentDescription="@string/cd_share"
                        android:src="@drawable/ic_share" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/totalLikes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/txtTotalLikes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        tools:text="128 likes" />

                    <TextView
                        android:id="@+id/txtCaptionPost"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:textSize="15sp"
                        tools:text="Caption" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


</FrameLayout>
