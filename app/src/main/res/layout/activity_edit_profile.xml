<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".activities.EditProfileActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/title_edit_profile" />

    </LinearLayout>

    <View style="@style/Divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/hint_username" />

            <EditText
                android:id="@+id/etUsername"
                style="@style/Input"
                android:imeOptions="actionNext"
                android:inputType="text|textNoSuggestions"
                android:maxLength="25" />

            <!-- Live availability, updated while typing a new username -->
            <TextView
                android:id="@+id/txtUsernameStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/montserrat_medium"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="@string/username_available"
                tools:textColor="@color/online"
                tools:visibility="visible" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/label_name" />

            <EditText
                android:id="@+id/etName"
                style="@style/Input"
                android:imeOptions="actionDone"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="25" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:animateLayoutChanges="true">

                <!-- Enabled only when a field differs from the saved profile -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/Button.Gradient"
                    android:layout_width="match_parent"
                    android:enabled="false"
                    android:text="@string/action_save" />

                <ProgressBar
                    android:id="@+id/progressSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/primary"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom-centre link -->
    <View style="@style/Divider" />

    <TextView
        android:id="@+id/txtChangePassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:text="@string/action_change_password"
        android:textColor="@color/primary"
        android:textSize="14sp" />

</LinearLayout>
