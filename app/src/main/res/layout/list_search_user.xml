<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imgProfileUser"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/avatar_default"
        app:civ_border_color="@color/outline"
        app:civ_border_width="1dp"
        app:civ_circle_background_color="@color/surface_variant" />

    <TextView
        android:id="@+id/txtUsernameUser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/montserrat_semi_bold"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        tools:text="username" />

    <!-- Optional right-hand text (e.g. when the like happened); hidden in search/follow lists -->
    <TextView
        android:id="@+id/txtTrailing"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:visibility="gone"
        tools:text="14.39"
        tools:visibility="visible" />

</LinearLayout>
